# Admin API Server Configuration
PORT=5001

# MySQL Database Configuration (same database as the main backend)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=fleetlink_db
DB_PORT=3306

# JWT Authentication
# Intentionally a DIFFERENT secret from the main backend so that a token
# issued by the public API (port 5000) can never be replayed against the admin API.
JWT_SECRET=replace_with_a_long_random_admin_only_secret
JWT_EXPIRES_IN=7d

# Credentials used by `npm run seed:admin` to create the first admin account
ADMIN_NAME=FleetLink Admin
ADMIN_EMAIL=admin@fleetlink.com
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+91 90000 00000
